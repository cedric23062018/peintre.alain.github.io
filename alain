<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alain - Peintre & Sculpteur</title>

<style>
body{
    margin:0;
    font-family: Georgia, serif;
    background:#e8dfd2;
    color:#3a2c1f;
}

/* HEADER */
header{
    height:90vh;
    background:
    linear-gradient(rgba(30,20,10,0.7),rgba(30,20,10,0.7)),
    url('hero.jpg');
    background-size:cover;
    background-position:center;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    color:white;
}

header h1{
    font-size:4rem;
    letter-spacing:2px;
}

header p{
    font-size:1.5rem;
}

/* NAV */
nav{
    background:#6b4a2f;
    padding:15px;
    text-align:center;
    position:sticky;
    top:0;
}

nav a{
    color:white;
    margin:0 15px;
    text-decoration:none;
    font-weight:bold;
}

/* SECTIONS */
section{
    padding:70px 10%;
}

h2{
    font-size:2.5rem;
    margin-bottom:20px;
    color:#5a3d25;
}

/* BIO */
.bio{
    background:#f5eee5;
    border-left:6px solid #a87445;
    padding:30px;
}

/* GALERIE */
.filters{
    text-align:center;
    margin-bottom:30px;
}

.filters button{
    margin:5px;
    padding:10px 15px;
    border:none;
    background:#7a5534;
    color:white;
    cursor:pointer;
}

.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.card{
    background:white;
    box-shadow:0 3px 10px rgba(0,0,0,0.2);
    cursor:pointer;
    transition:0.3s;
}

.card:hover{
    transform:scale(1.03);
}

.card img{
    width:100%;
    height:250px;
    object-fit:cover;
}

.card p{
    padding:10px;
}

/* MODAL ZOOM */
.modal{
    display:none;
    position:fixed;
    top:0;left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.9);
    justify-content:center;
    align-items:center;
}

.modal img{
    max-width:90%;
    max-height:80%;
}

/* ACTUALITES */
.news{
    background:#f5eee5;
}

.news-item{
    background:white;
    padding:20px;
    margin-bottom:15px;
    border-left:5px solid #a87445;
}

/* CONTACT */
.contact form{
    max-width:600px;
    margin:auto;
}

input,textarea{
    width:100%;
    padding:12px;
    margin-bottom:10px;
    border:1px solid #cdb9a4;
}

button{
    background:#7a5534;
    color:white;
    padding:12px 20px;
    border:none;
    cursor:pointer;
}

.whatsapp{
    display:inline-block;
    margin-top:20px;
    background:#25D366;
    color:white;
    padding:15px 20px;
    text-decoration:none;
}

/* FOOTER */
footer{
    background:#2d1f14;
    color:white;
    text-align:center;
    padding:20px;
}
</style>
</head>

<body>

<header>
<h1>Alain</h1>
<p>Peintre & Sculpteur – Lévignac, France</p>
</header>

<nav>
<a href="#bio">Biographie</a>
<a href="#gallery">Galerie</a>
<a href="#news">Actualités</a>
<a href="#contact">Contact</a>
</nav>

<!-- BIO -->
<section id="bio">
<h2>Biographie</h2>
<div class="bio">
<p>
👉 Écrivez ici votre biographie artistique.
<br><br>
Peintre et sculpteur, Alain développe une démarche entre
matière, lumière et émotion. Ses œuvres explorent les formes
classiques et contemporaines.
</p>
</div>
</section>

<!-- GALLERY -->
<section id="gallery">
<h2>Galerie</h2>

<div class="filters">
<button onclick="filter('all')">Tout</button>
<button onclick="filter('peinture')">Peintures</button>
<button onclick="filter('sculpture')">Sculptures</button>
</div>

<div class="gallery" id="gallery">

<!-- EXEMPLES (vous pourrez en ajouter 500+) -->
<div class="card peinture" onclick="openImg(this)">
<img src="img1.jpg">
<p>Œuvre peinture 1</p>
</div>

<div class="card sculpture" onclick="openImg(this)">
<img src="img2.jpg">
<p>Sculpture 1</p>
</div>

<div class="card peinture" onclick="openImg(this)">
<img src="img3.jpg">
<p>Œuvre peinture 2</p>
</div>

</div>
</section>

<!-- MODAL -->
<div class="modal" id="modal" onclick="this.style.display='none'">
<img id="modalImg">
</div>

<!-- NEWS -->
<section id="news">
<h2>Actualités & Expositions</h2>

<div class="news-item">
<h3>Exposition à venir</h3>
<p>Ajoutez ici vos expositions, dates et lieux.</p>
</div>

<div class="news-item">
<h3>Nouvelle création</h3>
<p>Présentation de vos nouvelles œuvres.</p>
</div>

</section>

<!-- CONTACT -->
<section id="contact">
<h2>Contact</h2>

<p>Email : votre@email.com</p>
<p>Téléphone : 06 00 00 00 00</p>

<form>
<input type="text" placeholder="Nom">
<input type="email" placeholder="Email">
<textarea rows="6" placeholder="Votre message"></textarea>
<button>Envoyer</button>
</form>

<a class="whatsapp"
href="https://wa.me/33600000000">
📱 WhatsApp
</a>
</section>

<footer>
© Alain - Peintre & Sculpteur
</footer>

<script>

// ZOOM IMAGE
function openImg(el){
    document.getElementById('modal').style.display='flex';
    document.getElementById('modalImg').src =
    el.querySelector('img').src;
}

// FILTRES
function filter(type){
    let cards = document.querySelectorAll('.card');
    cards.forEach(c=>{
        if(type==='all'){
            c.style.display='block';
        } else {
            c.style.display = c.classList.contains(type) ? 'block':'none';
        }
    });
}
</script>

</body>
</html>
